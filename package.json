{
  "name": "notasmax-frontend-postgresql",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
